# HAR.ZAP Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
#
# NOTE: Default values are in config.yaml
# Use .env only for secrets and environment-specific overrides

# =============================================================================
# SECRETS (required)
# =============================================================================

# ZAP API key (leave empty if using -config api.disablekey=true)
HARZAP_API_KEY=

# LLM API Keys (choose one provider)
HARZAP_LLM_API_KEY=sk-ant-xxxxx          # Anthropic
HARZAP_GEMINI_API_KEY=AIzaSyxxxxx        # Google Gemini

# =============================================================================
# ENVIRONMENT OVERRIDES (optional)
# =============================================================================

# Provider: anthropic | gemini
# HARZAP_LLM_PROVIDER=gemini

# ZAP URL (if not localhost:8080)
# HARZAP_ZAP_URL=http://zap:8080

# Tor proxy credentials
# HARZAP_TOR_PASSWORD=
# HARZAP_TOR_CONTROL_PASSWORD=

# Notifications webhook
# HARZAP_WEBHOOK_URL=https://hooks.slack.com/...

# =============================================================================
# DOCKER OBSERVABILITY (deployment/docker-compose.observability.yml)
# =============================================================================

# Log backend: loki | elasticsearch
LOG_BACKEND=loki
