# HAR.ZAP Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# ZAP Configuration
# =============================================================================
HARZAP_ZAP_URL=http://localhost:8080
HARZAP_ZAP_PORT=8080
HARZAP_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
HARZAP_API_KEY=

# =============================================================================
# Scan Settings
# =============================================================================
HARZAP_MAX_SCAN_TIME=3600
HARZAP_MAX_URLS=1000
HARZAP_MAX_WORKERS=10
HARZAP_RATE_LIMIT=10.0
HARZAP_RATE_BURST=20
HARZAP_INCREMENTAL=false

# =============================================================================
# Logging
# =============================================================================
HARZAP_DEBUG=false
HARZAP_LOG_LEVEL=INFO
HARZAP_LOG_JSON=false

# =============================================================================
# Notifications
# =============================================================================
HARZAP_WEBHOOK_URL=

# =============================================================================
# LLM Configuration (Anthropic)
# =============================================================================
HARZAP_LLM_ENABLED=true
HARZAP_LLM_PROVIDER=anthropic
HARZAP_LLM_API_KEY=sk-ant-xxxxx
HARZAP_LLM_MODEL=claude-sonnet-4-20250514
HARZAP_LLM_MAX_TOKENS=4096
HARZAP_LLM_TEMPERATURE=0.3
HARZAP_LLM_TIMEOUT=60
HARZAP_LLM_CACHE_TTL=24

# =============================================================================
# LLM Configuration (Gemini)
# =============================================================================
# HARZAP_LLM_PROVIDER=gemini
HARZAP_GEMINI_API_KEY=AIzaSyxxxxx
# HARZAP_LLM_MODEL=gemini-2.0-flash

# Gemini Batch Mode (async processing)
HARZAP_LLM_BATCH_ENABLED=false
HARZAP_LLM_BATCH_POLL_INTERVAL=5.0
HARZAP_LLM_BATCH_MAX_WAIT=3600

# =============================================================================
# Tor/Proxy Configuration
# =============================================================================
HARZAP_TOR_ENABLED=false
HARZAP_TOR_HOST=127.0.0.1
HARZAP_TOR_PORT=9050
HARZAP_TOR_TYPE=socks5
HARZAP_TOR_USERNAME=
HARZAP_TOR_PASSWORD=
HARZAP_TOR_CONTROL_PORT=9051
HARZAP_TOR_CONTROL_PASSWORD=
HARZAP_TOR_NEW_CIRCUIT_PER_SCAN=true

# =============================================================================
# Docker Observability (deployment/docker-compose.observability.yml)
# =============================================================================
LOG_BACKEND=loki
# LOG_BACKEND=elasticsearch
